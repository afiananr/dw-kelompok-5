  <step>
    <name>SCD2_Product_SQL</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>CONN_DW_KEL5</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <sql>
-- 1. Tutup versi lama jika atribut produk berubah
UPDATE dim_product d
JOIN stg_product p
    ON d.product_id = p.productid
LEFT JOIN stg_productmodel pm
    ON p.productmodelid = pm.productmodelid
LEFT JOIN stg_productsubcategory ps
    ON p.productsubcategoryid = ps.productsubcategoryid
LEFT JOIN stg_productcategory pc
    ON ps.productcategoryid = pc.productcategoryid
SET d.effective_end_date =
    DATE_SUB(DATE(p.modifieddate), INTERVAL 1 DAY)
WHERE d.is_current = 1
  AND d.product_id &lt;&gt; -1
  AND DATE(p.modifieddate) > d.effective_start_date
  AND (
    NOT (d.product_name COLLATE utf8mb4_unicode_ci
         &lt;=> p.name COLLATE utf8mb4_unicode_ci)
    OR NOT (d.product_number COLLATE utf8mb4_unicode_ci
         &lt;=> p.productnumber COLLATE utf8mb4_unicode_ci)
    OR NOT (d.product_model_id &lt;=> p.productmodelid)
    OR NOT (d.product_model_name COLLATE utf8mb4_unicode_ci
         &lt;=> COALESCE(pm.name, 'Not Assigned') COLLATE utf8mb4_unicode_ci)
    OR NOT (d.product_subcategory_id &lt;=> p.productsubcategoryid)
    OR NOT (d.product_subcategory_name COLLATE utf8mb4_unicode_ci
         &lt;=> COALESCE(ps.name, 'Not Assigned') COLLATE utf8mb4_unicode_ci)
    OR NOT (d.product_category_id &lt;=> ps.productcategoryid)
    OR NOT (d.product_category_name COLLATE utf8mb4_unicode_ci
         &lt;=> COALESCE(pc.name, 'Not Assigned') COLLATE utf8mb4_unicode_ci)
    OR NOT (d.color COLLATE utf8mb4_unicode_ci
         &lt;=> COALESCE(p.color, 'Not Specified') COLLATE utf8mb4_unicode_ci)
    OR NOT (d.size COLLATE utf8mb4_unicode_ci
         &lt;=> COALESCE(p.size, 'Not Specified') COLLATE utf8mb4_unicode_ci)
    OR NOT (d.standard_cost &lt;=> p.standardcost)
    OR NOT (d.list_price &lt;=> p.listprice)
  );

-- 2. Masukkan versi baru untuk produk yang berubah
INSERT INTO dim_product (
    version, product_id, product_name, product_number,
    product_model_id, product_model_name,
    product_subcategory_id, product_subcategory_name,
    product_category_id, product_category_name,
    color, size, standard_cost, list_price,
    effective_start_date, effective_end_date
)
SELECT
    old.version + 1,
    p.productid,
    p.name,
    p.productnumber,
    p.productmodelid,
    COALESCE(pm.name, 'Not Assigned'),
    p.productsubcategoryid,
    COALESCE(ps.name, 'Not Assigned'),
    ps.productcategoryid,
    COALESCE(pc.name, 'Not Assigned'),
    COALESCE(p.color, 'Not Specified'),
    COALESCE(p.size, 'Not Specified'),
    p.standardcost,
    p.listprice,
    DATE(p.modifieddate),
    '2199-12-31'
FROM stg_product p
LEFT JOIN stg_productmodel pm
    ON p.productmodelid = pm.productmodelid
LEFT JOIN stg_productsubcategory ps
    ON p.productsubcategoryid = ps.productsubcategoryid
LEFT JOIN stg_productcategory pc
    ON ps.productcategoryid = pc.productcategoryid
JOIN dim_product old
    ON old.product_id = p.productid
   AND old.effective_end_date =
       DATE_SUB(DATE(p.modifieddate), INTERVAL 1 DAY)
WHERE NOT EXISTS (
    SELECT 1
    FROM dim_product current_row
    WHERE current_row.product_id = p.productid
      AND current_row.is_current = 1
);
</sql>
