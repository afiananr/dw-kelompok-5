  <step>
    <name>Read_Product_Staging</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>CONN_DW_KEL5</connection>
    <sql>SELECT
    p.productid AS product_id,
    p.name AS product_name,
    p.productnumber AS product_number,
    p.productmodelid AS product_model_id,
    COALESCE(pm.name, 'Not Assigned') AS product_model_name,
    p.productsubcategoryid AS product_subcategory_id,
    COALESCE(ps.name, 'Not Assigned') AS product_subcategory_name,
    ps.productcategoryid AS product_category_id,
    COALESCE(pc.name, 'Not Assigned') AS product_category_name,
    COALESCE(p.color, 'Not Specified') AS color,
    COALESCE(p.size, 'Not Specified') AS size,
    p.standardcost AS standard_cost,
    p.listprice AS list_price,
    CAST(p.modifieddate AS DATE) AS modified_date,
    CAST(p.modifieddate AS DATE) AS effective_start_date
FROM stg_product p
LEFT JOIN stg_productmodel pm
    ON p.productmodelid = pm.productmodelid
LEFT JOIN stg_productsubcategory ps
    ON p.productsubcategoryid = ps.productsubcategoryid
LEFT JOIN stg_productcategory pc
    ON ps.productcategoryid = pc.productcategoryid</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
